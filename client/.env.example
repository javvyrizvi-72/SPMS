# Which API should the frontend talk to?
# Deployed API (recommended: localhost and the Vercel link then share the SAME accounts and data):
VITE_API_URL=https://placement-management-system-pe0o.onrender.com/api
# Local API (only if you run the server yourself on port 5000):
# VITE_API_URL=http://localhost:5000/api
# If this file is missing: localhost -> http://localhost:5000/api (falls back to the deployed API when it is not running),
# every other host (Vercel) -> the deployed API.
